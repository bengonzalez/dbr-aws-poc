# Local .terraform directories
**/.terraform/*
.terraform.lock.*

# Add tf.bat for now
tf.bat

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore any .tfvars files that are generated automatically for each Terraform run. Most
# .tfvars files are managed as part of configuration and so should be included in
# version control.
#
# example.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore the .vscode directory, which is used to store project-specific settings for Visual Studio Code.
.vscode/

# Ignore the __pycache__ directory, which is used to store compiled Python files.
__pycache__/

# Operator-local Databricks CLI profile name. This differs per person/machine
# and should never be committed. Terraform auto-loads this file alongside
# whatever -var-file is passed for a given workspace. Copy
# local.auto.tfvars.example to get started.
infrastructure/workspace/local.auto.tfvars