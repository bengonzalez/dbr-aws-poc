{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-config.schema.json",
  "title": "Databricks Workspace Normalized Configuration",
  "description": "Resolved configuration used by the Databricks workspace factory to provision a single workspace.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "api_version": {
      "type": "string",
      "const": "v1"
    },

    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "stage", "live"]
        },
        "isolation": {
          "type": "string",
          "enum": ["dedicated"]
        }
      },
      "required": [
        "name",
        "environment",
        "isolation"
      ]
    },

    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["aws"]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        }
      },
      "required": [
        "provider",
        "region",
        "account"
      ]
    },

    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,49}$"
        }
      },
      "required": [
        "name",
        "identifier"
      ]
    },

    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical_owner": {
          "type": "string",
          "minLength": 1
        },
        "business_owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "technical_owner",
        "business_owner"
      ]
    },

    "network": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["custom", "isolated"]
        },

        "architecture": {
          "type": "string",
          "enum": [
            "client_managed",
            "hybrid",
            "platform_managed"
          ]
        },

        "requirements": {
          "type": "object",
          "additionalProperties": false,

          "properties": {
            "vpc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownership": {
                  "type": "string",
                  "enum": ["existing", "terraform"]
                }
              },
              "required": [
                "ownership"
              ]
            },

            "subnets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownership": {
                  "type": "string",
                  "enum": ["existing", "terraform"],
                  "allocation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": ["platform"]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "availability_zones": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "cidr_source": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source",
                      "count",
                      "availability_zones",
                      "cidr_source"
                    ]
                  }
                },

                "private": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cidr": {
                        "type": "string"
                      },
                      "availability_zone": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "cidr",
                      "availability_zone"
                    ]
                  }
                }
              },
              "required": [
                "ownership"
              ]
            },

            "routing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownership": {
                  "type": "string",
                  "enum": ["existing", "terraform"]
                }
              },
              "required": [
                "ownership"
              ]
            },

            "security_groups": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownership": {
                  "type": "string",
                  "enum": ["existing", "terraform"]
                }
              },
              "required": [
                "ownership"
              ]
            },

            "endpoints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownership": {
                  "type": "string",
                  "enum": ["existing", "terraform"]
                }
              },
              "required": [
                "ownership"
              ]
            }
          },

          "required": [
            "vpc",
            "subnets",
            "routing",
            "security_groups",
            "endpoints"
          ]
        }
      },

      "required": [
        "strategy",
        "architecture",
        "requirements"
      ]
    },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification"
      ]
    },

    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string",
          "enum": [
            "platform_managed",
            "customer_managed"
          ]
        },
        "application_data": {
          "type": "string",
          "enum": [
            "platform_managed",
            "customer_managed"
          ]
        }
      },
      "required": [
        "workspace",
        "application_data"
      ]
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unity_catalog": {
          "type": "boolean"
        },
        "workspace_binding": {
          "type": "string",
          "enum": [
            "required",
            "recommended",
            "optional"
          ]
        }
      },
      "required": [
        "unity_catalog",
        "workspace_binding"
      ]
    },

    "compute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policy"
      ]
    },

    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "centralized": {
          "type": "boolean"
        },
        "audit": {
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "centralized",
        "audit"
      ]
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        },
        "negative_tests": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required",
        "blocking",
        "negative_tests",
        "evidence"
      ]
    },

    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },

  "required": [
    "api_version",
    "workspace",
    "cloud",
    "application",
    "ownership",
    "network",
    "data",
    "encryption",
    "governance",
    "compute",
    "logging",
    "validation",
    "tags"
  ]
}