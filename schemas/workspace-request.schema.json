{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-request.schema.json",
  "title": "Databricks Workspace Request",
  "description": "Request submitted to the Databricks workspace factory for provisioning a workspace.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "api_version": {
      "type": "string",
      "const": "v1"
    },

    "request": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{4,}$"
        },

        "submitted_by": {
          "type": "string",
          "minLength": 1
        },

        "source": {
          "type": "string",
          "enum": [
            "workspace-request"
          ]
        }
      },

      "required": [
        "id",
        "submitted_by",
        "source"
      ]
    },

    "workspace": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },

        "environment": {
          "type": "string",
          "enum": [
            "dev",
            "stage",
            "live"
          ]
        }
      },

      "required": [
        "name",
        "environment"
      ]
    },

    "cloud": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "aws"
          ]
        },

        "region": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "provider",
        "region"
      ]
    },

    "application": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "identifier": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,49}$"
        }
      },

      "required": [
        "name",
        "identifier"
      ]
    },

    "ownership": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "technical_owner": {
          "type": "string",
          "minLength": 1
        },

        "business_owner": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "technical_owner",
        "business_owner"
      ]
    },

    "data": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "classification"
      ]
    },

    "network": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "custom",
            "isolated"
          ]
        }
      },

      "required": [
        "strategy"
      ]
    },

    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },

  "required": [
    "api_version",
    "request",
    "workspace",
    "cloud",
    "application",
    "ownership",
    "data",
    "network",
    "tags"
  ]
}