{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Databricks Workspace Profile",
  "description": "Schema for a Databricks workspace provisioning profile. Describes only the fields resolver.py actually reads (CLAUDE.md Sec5.13 / Sec8 milestones 15-17) - a profile field with no corresponding resolver/Terraform logic doesn't belong here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "profile",
    "workspace",
    "encryption",
    "compute",
    "logging"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor-only hint pointing back at this file; not read by any code."
    },

    "api_version": {
      "type": "string",
      "description": "Version of the profile schema.",
      "const": "v1"
    },

    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "dev",
            "stage",
            "live"
          ]
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },

    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation"
      ],
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "dedicated"
          ]
        }
      }
    },

    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "application_data"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "enum": [
            "platform_managed",
            "customer_managed"
          ]
        },
        "application_data": {
          "type": "string",
          "enum": [
            "platform_managed",
            "customer_managed"
          ]
        }
      }
    },

    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "development",
            "stage",
            "production"
          ]
        }
      }
    },

    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "centralized"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "standard",
            "enhanced"
          ]
        },
        "centralized": {
          "type": "boolean"
        },
        "audit": {
          "type": "boolean"
        }
      }
    }
  }
}
